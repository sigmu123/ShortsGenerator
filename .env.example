# ShortsGenerator Environment Variables Configuration

# 1. Google Gemini API Key (Required for high-quality script generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Pexels API Key (Required for high-resolution stock video footage)
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Optional: ImageMagick Binary Path (Auto-detected on Linux/Docker)
# Windows Example: C:\Program Files\ImageMagick-7.1.1-Q16-HDRI\magick.exe
# Linux Example: /usr/bin/magick
IMAGEMAGICK_BINARY=

# 4. Server Host & Port Configuration
PORT=5000
HOST=0.0.0.0
